OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# SendGrid
SENDGRID_API_KEY=
FROM_EMAIL=
FROM_NAME=I Am An Artist
ADMIN_REPORT_EMAIL=

# DPO Pay
# DPO MODE = TEST/DEMO (internal testing only — NOT production payment readiness).
#
# DPO_COMPANY_TOKEN is REQUIRED at runtime. It is read from the environment
# only; dpo.js has NO hardcoded fallback and fails safely if it is unset.
# Provide the value via a gitignored functions/.env (deployed with the
# functions) or functions config/secrets. Never commit the token to Git.
DPO_COMPANY_TOKEN=
DPO_SERVICE_TYPE=54841
# Set APP_BASE_URL for DPO redirect URLs
APP_BASE_URL=https://www.iamanartistapp.com
