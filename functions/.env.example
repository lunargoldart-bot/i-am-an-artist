OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# SendGrid
SENDGRID_API_KEY=
FROM_EMAIL=
FROM_NAME=I Am An Artist
ADMIN_REPORT_EMAIL=

# DPO Pay
# Set your live DPO Company Token here. It is read from DPO_COMPANY_TOKEN
# in dpo.js. The token embedded in the source is a development placeholder and
# must be replaced before production launches.
DPO_COMPANY_TOKEN=
DPO_SERVICE_TYPE=54841
# Set APP_BASE_URL for DPO redirect URLs
APP_BASE_URL=https://www.iamanartistapp.com
